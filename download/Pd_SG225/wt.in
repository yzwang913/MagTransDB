&TB_FILE
Hrfile = 'wannier90_hr.dat'
/

LATTICE
Angstrom
0.0000000     1.9691944     1.9691944    
1.9691944     0.0000000     1.9691944    
1.9691944     1.9691944     0.0000000    

ATOM_POSITIONS
1
Cartisen
Pd       0.0000000     0.0000000     0.0000000


&CONTROL
Symmetry_import_calc  = T
Boltz_OHE_calc        = T
Fermilevel_calc=F
/

&SYSTEM
E_FERMI =9.18367616933915
Btheta = 90.00, Bphi = 0.00
SOC = 0
/

&PARAMETERS
OmegaNum = 5        ! omega number
OmegaMin =  -0.02     ! energy interval
OmegaMax =   0.02     ! energy interval
Nk1=30  ! Increase this value if negative magnetoresistance appears.
Nk2=30  ! Increase this value if negative magnetoresistance appears.
Nk3=30  ! Increase this value if negative magnetoresistance appears.
BTauNum = 101        ! Number of B*tau we calculate
BTauMax = 20         ! The maximum B*tau, starting from Btau=0.
Tmin = 10            ! Temperature in Kelvin
Tmax = 310           ! Temperature in Kelvin
NumT = 11            ! number temperature we calculate. T=Tmin+(Tmax-Tmin)/(NumT-1)
Nslice_BTau_Max = 10000  ! Increase this value if negative magnetoresistance appears.
EF_integral_range=0.06
RKF45_PERIODIC_LEVEL=2  ! Increase this value if negative magnetoresistance appears.
/

KCUBE_BULK
 0.00  0.00  0.00   ! Original point for 3D k plane
 1.00  0.00  0.00   ! The first vector to define 3d k space plane
 0.00  1.00  0.00   ! The second vector to define 3d k space plane
 0.00  0.00  1.00   ! The third vector to define 3d k cube

PROJECTORS
9
c s s s s s s s s s
