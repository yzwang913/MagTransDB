# Public path prefix. Leave empty for https://host/, or use /plausible for
# https://host/plausible/.
BASE_URL=/plausible

# The directory containing Lattice, MR, Band, fermi_surface, and download.
DATA_ROOT_HOST=/data/work/cmpdc/mrht/MR_HT_web_show

# Bind to loopback when Nginx runs on the Docker host.
HOST_BIND=127.0.0.1
HOST_PORT=2000

# Optional local image name.
IMAGE_NAME=magtransdb:local
