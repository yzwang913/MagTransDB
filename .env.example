# Copy to .env.production on the deployment host.
# Public URL: https://cmpdc.iphy.ac.cn/mtdb/. Leave empty for root hosting.
BASE_URL=/mtdb

# Host scientific-data directory; mounted read-only in the container.
DATA_ROOT_HOST=/data/work/projects/magtransdb/data

# Authentication is required for all material pages, APIs, and downloads.
AUTH_ENABLED=true
AUTH_DB_HOST=/data/work/projects/magtransdb/state
AUTH_DATABASE_PATH=/state/auth.sqlite3

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=replace-with-a-long-random-value
PUBLIC_BASE_URL=https://cmpdc.iphy.ac.cn/mtdb
SESSION_COOKIE_SECURE=true

# SMTP settings for verification and password-reset email.
MAIL_SERVER=smtp.example.org
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="MagTransDB <no-reply@example.org>"
MAIL_TIMEOUT=10
MAIL_SUPPRESS_SEND=false

EMAIL_VERIFICATION_MAX_AGE=86400
PASSWORD_RESET_MAX_AGE=3600

# Runtime tuning; keep Gunicorn heartbeat files in memory-backed /dev/shm.
GUNICORN_CMD_ARGS="--bind 0.0.0.0:8000 --worker-class gthread --workers 2 --threads 4 --worker-tmp-dir /dev/shm --timeout 120 --access-logfile - --error-logfile -"
