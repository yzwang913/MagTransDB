# Copy to .env.production on the deployment host.
# Public URL: https://cmpdc.iphy.ac.cn/mtdb/. Leave empty for root hosting.
BASE_URL=/mtdb

# Host data directory; container paths are defined in the Dockerfile.
DATA_ROOT_HOST=../magtransdb-data

# Runtime tuning; keep Gunicorn heartbeat files in memory-backed /dev/shm.
GUNICORN_CMD_ARGS="--bind 0.0.0.0:8000 --worker-class gthread --workers 2 --threads 4 --worker-tmp-dir /dev/shm --timeout 120 --access-logfile - --error-logfile -"
